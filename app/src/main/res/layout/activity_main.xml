<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BINANCE / MARKET CHECKER" android:textColor="@color/muted" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/app_name" android:textColor="@color/text" android:textSize="28sp" android:textStyle="bold"/>
  <TextView android:id="@+id/symbolHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="BTCUSDT • Loading…" android:textColor="@color/muted" android:textSize="14sp"/>
  <TextView android:id="@+id/permissionState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="11dp" android:background="#1A2435" android:text="FLOATING BADGE • CHECKING" android:textColor="@color/dnt" android:textSize="12sp" android:textStyle="bold"/>
  <Button android:id="@+id/permissionButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="@string/grant_overlay"/>
  <EditText android:id="@+id/symbolInput" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="13dp" android:background="#252F42" android:hint="BTCUSDT" android:importantForAutofill="no" android:inputType="textCapCharacters" android:paddingStart="13dp" android:paddingEnd="13dp" android:singleLine="true" android:textColor="@color/text" android:textColorHint="@color/muted" android:textSize="15sp"/>
  <Button android:id="@+id/startButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="9dp" android:text="SHOW ON SCREEN" android:textStyle="bold"/>
  <Button android:id="@+id/stopButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="STOP FLOATING BADGE"/>
  <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/muted" android:textSize="12sp"/>
  <TextView android:id="@+id/overallStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="17dp" android:padding="13dp" android:background="#1A2435" android:text="CURRENT DECISION: WAITING" android:textColor="@color/text" android:textSize="18sp" android:textStyle="bold"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="CHART BREAKDOWNS" android:textColor="@color/muted" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08"/>
  <TextView android:id="@+id/chart5" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="13dp" android:background="#1A2435" android:text="5 MINUTE CHART&#10;Waiting…" android:textColor="@color/text" android:textSize="12sp" android:lineSpacingExtra="3dp"/>
  <TextView android:id="@+id/chart15" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="13dp" android:background="#1A2435" android:text="15 MINUTE CHART&#10;Waiting…" android:textColor="@color/text" android:textSize="12sp" android:lineSpacingExtra="3dp"/>
  <TextView android:id="@+id/chart1h" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="13dp" android:background="#1A2435" android:text="1 HOUR CHART&#10;Waiting…" android:textColor="@color/text" android:textSize="12sp" android:lineSpacingExtra="3dp"/>
  <Button android:id="@+id/refreshButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="REFRESH CHART DATA"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="PROBLEMS / BLOCKERS" android:textColor="@color/muted" android:textSize="11sp" android:textStyle="bold"/>
  <TextView android:id="@+id/problemsText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:padding="13dp" android:background="#1A2435" android:text="Waiting for chart checks…" android:textColor="@color/text" android:textSize="12sp" android:lineSpacingExtra="3dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="CONNECTION / ERROR LOG" android:textColor="@color/muted" android:textSize="11sp" android:textStyle="bold"/>
  <TextView android:id="@+id/logText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:padding="13dp" android:background="#1A2435" android:text="Waiting for connection log…" android:textColor="@color/text" android:textSize="11sp" android:lineSpacingExtra="3dp" android:textIsSelectable="true"/>
 </LinearLayout>
</ScrollView>
