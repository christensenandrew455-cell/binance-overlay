<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="24dp"
        android:paddingBottom="36dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BINANCE.US / INDICATOR MONITOR"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="28sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/symbolHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="BTCUSDT • Waiting to start"
            android:textColor="@color/muted"
            android:textSize="14sp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="EMA 7 + UNUSUAL-MOVEMENT DETECTION"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/targetText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:padding="14dp"
            android:background="#1A2435"
            android:text="Waiting for 100 one-minute candles…"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"/>
        <EditText
            android:id="@+id/symbolInput"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:background="#252F42"
            android:hint="BTCUSDT"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="15sp"/>
        <Button
            android:id="@+id/startCheckButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="9dp"
            android:text="START MONITORING"
            android:textStyle="bold"/>
        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="SHOW FLOATING MONITOR"/>
        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="STOP MONITORING"/>
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/muted"
            android:textSize="12sp"/>
        <TextView
            android:id="@+id/overallStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="16dp"
            android:background="#1A2435"
            android:text="COLLECTING CANDLES"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/reasonText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="13dp"
            android:background="#202B3E"
            android:text="EMA 7 and anomaly details will appear here."
            android:textColor="@color/text"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="BINANCE.US DATA STATUS"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/problemsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:padding="13dp"
            android:background="#1A2435"
            android:text="Press START MONITORING to begin."
            android:textColor="@color/text"
            android:textSize="12sp"/>
        <Button
            android:id="@+id/refreshButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="REFRESH MARKET DATA"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="FETCH LOG"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:padding="13dp"
            android:background="#1A2435"
            android:text="No checks have run yet."
            android:textColor="@color/text"
            android:textSize="11sp"
            android:lineSpacingExtra="3dp"
            android:textIsSelectable="true"/>
    </LinearLayout>
</ScrollView>
